# Keep source and configuration files normalized across Windows and Linux deployments.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# The canonical trained model is a binary artifact and should never be text-diffed.
backend/models/*.keras binary
